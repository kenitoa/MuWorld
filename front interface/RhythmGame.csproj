    </None>
    <None Include="Songs\InGameBGM\Original\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Songs\InGameBGM\Original\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Songs\InGameBGM\Original\**\*.jpg">
